[Unit]
Description=NQ Futures Strategy (IBKR TWS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/opt/nq-futures-bot
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/opt/nq-futures-bot/.env
ExecStart=/opt/nq-futures-bot/venv/bin/python run_strategy.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
